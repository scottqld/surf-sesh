# SurfSesh API secrets/config. Copy to `.env` (git-ignored) and fill in.
# Generate VAPID_* and AUTH_SECRET with:  npm run gen-keys

# Web Push (VAPID). The PUBLIC key must also be pasted into index.html's
# VAPID_PUBLIC_KEY const so the client subscribes against the same keypair.
# A fresh keypair means every device re-enables notifications once.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY_JWK=

# Signs the per-user auth token. A new value logs everyone out once (accounts
# still work — they re-login with their existing name + PIN).
AUTH_SECRET=

# Invite code required to register a new account (unchanged from Cloudflare).
GROUP_PASSCODE=9344

# Optional: enables the AI-written one-liner in push notifications and /ai.
ANTHROPIC_API_KEY=
